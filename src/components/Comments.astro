---
import { giscus, giscusReady } from '../config';

// GitHub Discussions comments (giscus). Renders nothing until the two ids are
// filled in src/config.ts — enabling Discussions + installing the giscus app
// are manual steps (see the migration notes). Chosen over Disqus: no ads, no
// third-party trackers, so the consent banner stays unnecessary.
---
{giscusReady && (
  <div class="comments">
    <script
      src="https://giscus.app/client.js"
      data-repo={giscus.repo}
      data-repo-id={giscus.repoId}
      data-category={giscus.category}
      data-category-id={giscus.categoryId}
      data-mapping={giscus.mapping}
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang="es"
      crossorigin="anonymous"
      async
    ></script>
  </div>
)}
